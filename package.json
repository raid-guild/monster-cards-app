{
  "name": "monsters-ember-archive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev --webpack",
    "dev:turbopack": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "worker:once": "WORKER_ONCE=true tsx src/worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-style.ts",
    "operator:hide": "tsx scripts/hide-visualization.ts",
    "operator:replace": "tsx scripts/approve-replacement.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/silkscreen": "^5.2.6",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.85.0",
    "@x402/core": "^2.22.0",
    "@x402/evm": "^2.22.0",
    "@x402/svm": "^2.22.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.2.5",
    "jose": "^6.0.12",
    "lucide-react": "^0.539.0",
    "next": "16.3.1",
    "openai": "^6.49.0",
    "postgres": "^3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "siwe": "^3.0.0",
    "viem": "^2.55.16",
    "wagmi": "^2.19.5",
    "zod": "^4.0.17"
  },
  "overrides": {
